ENVIRONMENT=local
LOG_LEVEL=INFO

# HRIS_DRIVER selects the HRISPort implementation: "memory" (default,
# no credentials needed) or "bamboohr".
HRIS_DRIVER=memory
BAMBOOHR_SUBDOMAIN=
BAMBOOHR_API_KEY=

# DASHBOARD_DRIVER selects the DashboardPort implementation: "memory"
# (default, no credentials needed) or "sheets". Setting up "sheets"
# requires, on the Google Cloud side: a project with the Google Sheets
# API enabled, a service account with a downloaded JSON key, and a
# spreadsheet shared with that service account's email as an Editor
# (service accounts have no Drive storage of their own -- sharing is how
# they get access to a specific sheet). The sheet's first tab must have
# these exact headers in row 1: employee_id, checkin_date,
# accomplishments, blockers, rating, submitted_by, submitted_at,
# idempotency_key.
DASHBOARD_DRIVER=memory
GOOGLE_SHEETS_CREDENTIALS_PATH=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=checkins

# Required, no default -- signs and verifies leave-preview tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PREVIEW_TOKEN_SECRET=
